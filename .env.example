# Скопируй этот файл в .env и подставь свои значения.
# .env уже в .gitignore и в репозиторий не попадёт.
#
# Как получить:
#   1. API key  — https://trello.com/power-ups/admin  (создать Power-Up, взять ключ)
#   2. Токен    — открыть в браузере, подставив свой ключ:
#      https://trello.com/1/authorize?expiration=30days&scope=read,write&response_type=token&name=TrelloDeep&key=ВАШ_КЛЮЧ
#
# Скоуп account НЕ запрашивать. expiration=never НЕ ставить (только 30days и перевыпускать).
# Отзыв при компрометации: https://trello.com/my/account -> Applications -> Revoke

TRELLO_KEY=
TRELLO_TOKEN=
